---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Regional Insights — AIR Lab" description="Understanding the pulse of Southeast Asia's airspace — how AIR Lab transforms operational data into a shared regional picture.">
  <Nav slot="nav" />

  <!-- HERO -->
  <div class="page-hero">
    <div class="page-hero-content">
      <h1>Regional <strong>insights</strong></h1>
      <p style="color: rgba(255,255,255,0.9); font-weight: 600; margin-bottom: 28px;">Understanding the pulse of Southeast Asia's airspace</p>
      <p>Air traffic is a highly interconnected system. Every day, thousands of flights, airports and air navigation service providers influence each other's performance across the region.<br/><br/>AIR Lab transforms operational data into a shared regional picture, to understand traffic flows, identify bottlenecks and support collaborative decision-making.</p>
    </div>
  </div>

  <!-- WHY IT MATTERS -->
  <section style="background: var(--off-white);">
    <div class="section-header">
      <div class="section-label">Context</div>
      <h2 class="section-title">Why it <strong>matters</strong></h2>
      <p class="section-intro">As traffic continues to grow, airspace complexity grows with it.</p>
    </div>
    <div class="rh-stats">
      <div class="rh-stat">
        <div class="rh-stat-tag">Today</div>
        <div class="rh-stat-num">34<span>%</span></div>
        <div class="rh-stat-lbl">of global passenger traffic is in Asia-Pacific</div>
      </div>
      <div class="rh-stat">
        <div class="rh-stat-tag">By 2043</div>
        <div class="rh-stat-num">46<span>%</span></div>
        <div class="rh-stat-lbl">of global passenger traffic will be in Asia-Pacific</div>
      </div>
      <div class="rh-stat">
        <div class="rh-stat-tag">Growth</div>
        <div class="rh-stat-num">+2.75<span>B</span></div>
        <div class="rh-stat-lbl">additional passengers expected in the region</div>
      </div>
    </div>
    <p class="rh-stat-source">Source: IATA 20-Year Passenger Forecast</p>
  </section>

  <!-- FROM DATA TO INTELLIGENCE -->
  <section>
    <div class="section-header">
      <div class="section-label">Analytics</div>
      <h2 class="section-title">From data <strong>to intelligence</strong></h2>
      <p class="section-intro">Data alone does not improve performance. AIR Lab combines operational, traffic and network data to generate actionable insights.</p>
    </div>

    <!-- Traffic Flows — full-width flip card -->
    <div class="rh-flip-wrapper rh-flip-featured" onclick="this.classList.toggle('flipped')">
      <!-- ghost sets height for back face -->
      <div class="rh-flip-ghost rh-flip-ghost-featured" aria-hidden="true">
        <div class="rh-featured-back-inner">
          <div class="rh-featured-back-stats">
            <h3>Traffic flows</h3>
            <ul class="rh-flip-stats">
              <li><strong>6.25M+</strong> aircraft traversals analysed across the APAC network.</li>
              <li><strong>~30,000</strong> aircraft movements at the busiest airport during the analysis period.</li>
              <li><strong>3,800+</strong> flights on the busiest city-pair corridor in a single month.</li>
            </ul>
            <p class="rh-flip-conclusion">Traffic analysis reveals where demand concentrates and how flows evolve across the network.</p>
            <span class="rh-flip-hint">Click to go back ←</span>
          </div>
          <div class="rh-featured-back-map">
            <img src={`${base}/regional-health-map.png`} alt="Regional traffic map" />
          </div>
        </div>
      </div>
      <div class="rh-flip-inner">
        <!-- FRONT -->
        <div class="rh-flip-front rh-flip-front-featured">
          <div class="rh-data-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12h18M3 6l9-3 9 3M3 18l9 3 9-3"/></svg>
          </div>
          <h3>Traffic flows</h3>
          <p>Where traffic is concentrated and how it evolves across Southeast Asia's airspace.</p>
          <span class="rh-flip-hint">Click to explore →</span>
        </div>
        <!-- BACK -->
        <div class="rh-flip-back rh-flip-back-featured">
          <div class="rh-featured-back-inner">
            <div class="rh-featured-back-stats">
              <h3>Traffic flows</h3>
              <ul class="rh-flip-stats">
                <li><strong>6.25M+</strong> aircraft traversals analysed across the APAC network.</li>
                <li><strong>~30,000</strong> aircraft movements at the busiest airport during the analysis period.</li>
                <li><strong>3,800+</strong> flights on the busiest city-pair corridor in a single month.</li>
              </ul>
              <p class="rh-flip-conclusion">Traffic analysis reveals where demand concentrates and how flows evolve across the network.</p>
              <span class="rh-flip-hint">Click to go back ←</span>
            </div>
            <div class="rh-featured-back-map">
              <img src={`${base}/regional-health-map.png`} alt="Regional traffic map" />
              <span class="rh-map-caption">Live regional situational awareness, South East Asia airspace</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- In-depth analyses — 2-col flip cards -->
    <div class="rh-indepth-label">
      <span>In-depth analyses</span>
    </div>
    <div class="rh-data-grid">

      <div class="rh-flip-wrapper" onclick="this.classList.toggle('flipped')">
        <div class="rh-flip-ghost" aria-hidden="true">
          <h3>Network dependencies</h3>
          <ul class="rh-flip-stats">
            <li><strong>1 critical bottleneck</strong> identified as having the highest influence on regional connectivity.</li>
            <li>Connectivity mapping reveals where disruptions may propagate across multiple sectors and neighbouring airspaces.</li>
            <li><strong>Top 5 Most Connected Airports</strong> highlights the network's most influential traffic hubs.</li>
          </ul>
          <p class="rh-flip-conclusion">Understand how traffic flows are interconnected and identify the routes, sectors and nodes that have the greatest influence on network performance.</p>
          <span class="rh-flip-hint">Click to go back ←</span>
        </div>
        <div class="rh-flip-inner">
          <div class="rh-flip-front">
            <div class="rh-data-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"/></svg>
            </div>
            <h3>Network dependencies</h3>
            <p>How disruptions in one location can impact the wider region.</p>
            <span class="rh-flip-hint">Click to explore →</span>
          </div>
          <div class="rh-flip-back">
            <h3>Network dependencies</h3>
            <ul class="rh-flip-stats">
              <li><strong>1 critical bottleneck</strong> identified as having the highest influence on regional connectivity.</li>
              <li>Connectivity mapping reveals where disruptions may propagate across multiple sectors and neighbouring airspaces.</li>
              <li><strong>Top 5 Most Connected Airports</strong> highlights the network's most influential traffic hubs.</li>
            </ul>
            <p class="rh-flip-conclusion">Understand how traffic flows are interconnected and identify the routes, sectors and nodes that have the greatest influence on network performance.</p>
            <span class="rh-flip-hint">Click to go back ←</span>
          </div>
        </div>
      </div>

      <div class="rh-flip-wrapper" onclick="this.classList.toggle('flipped')">
        <div class="rh-flip-ghost" aria-hidden="true">
          <h3>Capacity &amp; demand</h3>
          <ul class="rh-flip-stats">
            <li>Capacity hotspots across the network.</li>
            <li>Airspace utilisation and demand pressure trends.</li>
            <li>Peak demand periods and congestion patterns.</li>
            <li>Emerging bottlenecks and future constraints.</li>
            <li>Demand-to-capacity balance across routes and sectors.</li>
          </ul>
          <p class="rh-flip-conclusion">Identify where demand is approaching operational limits and where future constraints may emerge.</p>
          <span class="rh-flip-hint">Click to go back ←</span>
        </div>
        <div class="rh-flip-inner">
          <div class="rh-flip-front">
            <div class="rh-data-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            </div>
            <h3>Capacity &amp; demand</h3>
            <p>Where pressure points are emerging and where additional coordination may be needed.</p>
            <span class="rh-flip-hint">Click to explore →</span>
          </div>
          <div class="rh-flip-back">
            <h3>Capacity &amp; demand</h3>
            <ul class="rh-flip-stats">
              <li>Capacity hotspots across the network.</li>
              <li>Airspace utilisation and demand pressure trends.</li>
              <li>Peak demand periods and congestion patterns.</li>
              <li>Emerging bottlenecks and future constraints.</li>
              <li>Demand-to-capacity balance across routes and sectors.</li>
            </ul>
            <p class="rh-flip-conclusion">Identify where demand is approaching operational limits and where future constraints may emerge.</p>
            <span class="rh-flip-hint">Click to go back ←</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- LOOKING BEYOND -->
  <section style="background: var(--navy);">
    <div class="section-header">
      <div class="section-label">Perspective</div>
      <h2 class="section-title" style="color:#fff;">Looking beyond <strong>today's operations</strong></h2>
      <p class="section-intro" style="color:rgba(255,255,255,0.55);">The real value of regional data lies not only in understanding what happened, but also in preparing for what comes next.</p>
    </div>
  </section>

  <!-- JOIN THE CONVERSATION -->
  <section style="background: var(--navy); padding-top: 0;">
    <div style="max-width: 600px; margin: 0 auto; text-align: center;">
      <div class="section-label">Get involved</div>
      <h2 class="section-title" style="color:#fff; margin-bottom: 20px;">Join the <strong>conversation</strong></h2>
      <p style="font-size: 15px; color: rgba(255,255,255,0.55); line-height: 1.7; margin-bottom: 12px;">Regional challenges cannot be solved by a single stakeholder. AIR Lab brings together ANSPs, airports, airlines and industry partners to explore how data and innovation can help shape the future of airspace management.</p>
      <p style="font-size: 15px; color: rgba(255,255,255,0.4); margin-bottom: 36px;">Interested in contributing or learning more?</p>
      <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
        <a href={`${base}/contact`} class="btn-airlab">Contact us</a>
        <a href="https://rcp-landing-page.rcp.pub.airlab.thalesdigital.io/" target="_blank" class="btn-ghost-dark">Log in to RCP</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>


<style>
  /* HERO */
  .page-hero-content { max-width: 900px; }

  /* STATS */
  .rh-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; max-width: 800px; margin: 0 auto; }
  .rh-stat { text-align: center; }
  .rh-stat-tag { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--teal); font-weight: 600; margin-bottom: 8px; }
  .rh-stat-num { font-size: 48px; font-weight: 700; color: var(--navy); line-height: 1; margin-bottom: 10px; }
  .rh-stat-num span { font-size: 24px; color: var(--teal); }
  .rh-stat-lbl { font-size: 14px; color: var(--muted); line-height: 1.5; }
  .rh-stat-source { font-size: 11px; color: #aaa; margin-top: 32px; font-style: italic; text-align: center; }

  /* MAP caption */
  .rh-map-caption { position: absolute; bottom: 12px; left: 16px; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.35); }

  /* FEATURED flip card (Traffic Flows) */
  .rh-flip-featured { margin-bottom: 24px; }
  .rh-flip-ghost-featured { padding: 32px; border: 1px solid transparent; border-radius: 16px; }
  .rh-flip-front-featured { padding: 40px 48px; }
  .rh-flip-back-featured { padding: 0; overflow: hidden; }
  .rh-featured-back-inner { display: grid; grid-template-columns: 300px 1fr; height: 100%; }
  .rh-featured-back-stats { padding: 36px 32px; display: flex; flex-direction: column; gap: 0; }
  .rh-featured-back-stats h3 { color: #fff; font-size: 18px; font-weight: 700; margin-bottom: 20px; }
  .rh-featured-back-stats .rh-flip-stats { flex: 1; }
  .rh-featured-back-map { position: relative; line-height: 0; }
  .rh-featured-back-map img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* In-depth label */
  .rh-indepth-label { margin: 40px 0 20px; }
  .rh-indepth-label span { font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--teal); }

  /* DATA CARDS */
  .rh-data-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; align-items: start; }
  .rh-data-card { background: var(--off-white); border: 1px solid var(--border); border-radius: 16px; padding: 28px 24px; transition: all 0.25s; }
  .rh-data-card:hover { border-color: var(--teal); transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,0.08); }
  .rh-data-icon { width: 44px; height: 44px; background: rgba(6,113,129,0.1); border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-bottom: 16px; }
  .rh-data-icon svg { width: 22px; height: 22px; stroke: var(--teal); }
  .rh-data-card h3 { font-size: 16px; font-weight: 700; color: var(--navy); margin-bottom: 10px; }
  .rh-data-card p { font-size: 14px; color: var(--muted); line-height: 1.65; margin: 0; }

  /* FLIP CARD */
  .rh-flip-wrapper { perspective: 1000px; cursor: pointer; position: relative; }
  /* ghost is the only in-flow element — sets the wrapper height */
  .rh-flip-ghost { visibility: hidden; pointer-events: none; padding: 28px 24px; border: 1px solid transparent; border-radius: 16px; }
  /* inner is overlaid on top of ghost, filling exact same space */
  .rh-flip-inner { position: absolute; inset: 0; transform-style: preserve-3d; transition: transform 0.6s cubic-bezier(0.4,0.2,0.2,1); }
  .rh-flip-wrapper.flipped .rh-flip-inner { transform: rotateY(180deg); }
  .rh-flip-front, .rh-flip-back { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; border-radius: 16px; display: flex; flex-direction: column; }
  .rh-flip-front { background: var(--off-white); border: 1px solid var(--border); padding: 28px 24px; }
  .rh-flip-back { transform: rotateY(180deg); background: var(--navy); border: 1px solid var(--teal); padding: 28px 24px; justify-content: space-between; }
  .rh-flip-back h3 { color: #fff; font-size: 16px; font-weight: 700; margin-bottom: 10px; }
  .rh-flip-stats { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .rh-flip-stats li { font-size: 13px; color: rgba(255,255,255,0.6); line-height: 1.6; padding-left: 14px; position: relative; }
  .rh-flip-stats li::before { content: '—'; position: absolute; left: 0; color: var(--teal); }
  .rh-flip-stats li strong { color: #fff; font-weight: 700; font-size: 15px; display: block; }
  .rh-flip-conclusion { font-size: 12px; color: #F97316; font-style: italic; margin-top: 14px; line-height: 1.6; }
  .rh-flip-hint { display: block; margin-top: 14px; font-size: 11px; letter-spacing: 0.08em; color: var(--teal); text-transform: uppercase; }

  /* BUTTONS */
  .btn-ghost-dark { display: inline-block; padding: 14px 28px; border: 1px solid rgba(255,255,255,0.25); border-radius: 4px; color: rgba(255,255,255,0.7); text-decoration: none; font-size: 15px; font-weight: 400; transition: all 0.2s; }
  .btn-ghost-dark:hover { border-color: #fff; color: #fff; }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .page-hero { padding: 100px 24px 60px; }
    .rh-featured-back-inner { grid-template-columns: 1fr; }
    .rh-featured-back-map { height: 220px; }
    .rh-data-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .rh-stats { grid-template-columns: 1fr; max-width: 300px; }
    .rh-data-grid { grid-template-columns: 1fr; }
  }
</style>
