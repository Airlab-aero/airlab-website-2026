---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="About" description="AIR Lab is a joint innovation laboratory by CAAS and Thales, advancing air traffic management in Asia-Pacific through open collaboration and technology.">
  <Nav slot="nav" />

  <!-- HERO -->
  <div class="page-hero">
    <div class="page-hero-content">
      <div class="section-label">About us</div>
      <h1>Advancing <strong>aviation</strong><br>across Asia-Pacific</h1>
      <p>Co-founded by CAAS and Thales in 2019, AIR Lab is dedicated to ATM research and development in the Asia-Pacific region, bringing together operational expertise and world-class technology.</p>
    </div>
  </div>

  <!-- VISION -->
  <section class="about-mission">
    <div class="am-grid" data-reveal>
      <div class="am-left">
        <div class="section-label">Our vision</div>
        <h2 class="section-title">Built to innovate,<br><strong>together</strong></h2>
      </div>
      <div class="am-right">
        <p class="am-intro">"To innovate, experiment, design, and learn how digital technologies can benefit ATM systems for today and tomorrow."</p>
        <p class="am-body">AIR Lab exists to bridge the gap between operational expertise and technological innovation, creating an open, neutral space where ANSPs, researchers, and technology providers can work together. Our focus is Asia-Pacific, the world's fastest-growing aviation region.</p>
      </div>
    </div>
  </section>

  <!-- TEAM STATS -->
  <section class="team-stats" style="background: var(--navy);">
    <div class="ts-grid" data-reveal>
      <div class="ts-stat">
        <div class="ts-num">60<span>+</span></div>
        <div class="ts-lbl">Experts from CAAS & Thales</div>
      </div>
      <div class="ts-stat">
        <div class="ts-num">10<span>+</span></div>
        <div class="ts-lbl">ANSPs onboarded on the RCP</div>
      </div>
      <div class="ts-stat">
        <div class="ts-num">2019</div>
        <div class="ts-lbl">Year AIR Lab was founded</div>
      </div>
    </div>
    <div class="ts-profiles" data-reveal>
      <div class="section-label" style="color: var(--teal); margin-bottom: 24px;">Key profiles</div>
      <div class="ts-tags">
        <span>ATM Experts</span>
        <span>Full-Stack Engineers</span>
        <span>UI/UX Designers</span>
        <span>Data Engineers</span>
        <span>DevOps</span>
        <span>Cybersecurity</span>
        <span>Architects</span>
        <span>Scrum Masters</span>
      </div>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="journey" style="background: var(--navy);">
    <div class="section-header" data-reveal>
      <div class="section-label" style="color: var(--teal);">AIR Lab's Journey</div>
      <h2 class="section-title" style="color:#fff;">From Joint Lab<br><strong>to Regional Collaboration</strong></h2>
    </div>
    <div class="timeline">
      <div class="timeline-item" data-reveal data-reveal-delay="0">
        <div class="timeline-dot"></div>
        <div class="timeline-year">2019–23</div>
        <div class="timeline-heading">Initializing Capabilities</div>
        <div class="timeline-body">From 10 to 45 people, 4 squads formed. World's first ATM Twin deployed in the Cloud. Foundational platform built on open technologies.</div>
      </div>
      <div class="timeline-item" data-reveal data-reveal-delay="100">
        <div class="timeline-dot"></div>
        <div class="timeline-year">2024</div>
        <div class="timeline-heading">Going Regional</div>
        <div class="timeline-body">Regional Collaboration Platform (RCP) launched. First ANSPs onboarded. Live & historical data integration. 4D trajectory prediction.</div>
      </div>
      <div class="timeline-item active" data-reveal data-reveal-delay="200">
        <div class="timeline-dot"></div>
        <div class="timeline-year">2025</div>
        <div class="timeline-heading">FF-ICE Onboarding</div>
        <div class="timeline-body">Progressive ANSP onboarding. Full FF-ICE/R1 stack deployed. Fast-time simulation capabilities introduced. 10 ANSPs + 2 airlines onboarded.</div>
      </div>
      <div class="timeline-item" data-reveal data-reveal-delay="300">
        <div class="timeline-dot"></div>
        <div class="timeline-year" style="color:#fff;">2026+</div>
        <div class="timeline-heading">Structured Collaboration</div>
        <div class="timeline-body">Expanding RCP across APAC. Advanced weather forecasting. New use cases co-developed with ANSP partners. Supported by ICAO & CANSO engagement.</div>
      </div>
    </div>
  </section>

  <!-- FOUNDING PARTNERS -->
  <section style="background: var(--off-white);">
    <div class="section-header" data-reveal>
      <div class="section-label">Founding partners</div>
      <h2 class="section-title">Built on a strong<br><strong>foundation</strong></h2>
    </div>
    <div class="fp-grid" data-reveal>
      <div class="fp-card">
        <img src={`${base}/images/partners/caas.png`} alt="CAAS" />
        <h3>Civil Aviation Authority of Singapore</h3>
        <p>CAAS oversees the development of Singapore's civil aviation sector and is one of Asia-Pacific's leading air navigation service providers. As a founding partner, CAAS brings decades of operational expertise and a deep commitment to regional aviation excellence.</p>
      </div>
      <div class="fp-card">
        <img src={`${base}/images/partners/thales.webp`} alt="Thales" />
        <h3>Thales</h3>
        <p>Thales is a global leader in aerospace, defence, and digital security. As a founding partner of AIR Lab, Thales provides world-class engineering capabilities, advanced ATM technologies, and a global network of aviation innovation, including Thales Digital Factory, Thales R&T, and CortAIx.</p>
      </div>
    </div>
  </section>

  <!-- COLLABORATION -->
  <section class="collab-section">
    <div class="collab-inner" data-reveal>
      <div class="collab-left">
        <div class="section-label">Collaboration</div>
        <h2 class="section-title">Collaborating across<br><strong>the ATM ecosystem</strong></h2>
        <div class="collab-cards">
          <div class="collab-card">
            <div class="collab-card-label">Thales Ecosystem</div>
            <ul>
              <li>Thales Digital Factory</li>
              <li>Thales R&amp;T</li>
              <li>CortAIx</li>
            </ul>
          </div>
          <div class="collab-card">
            <div class="collab-card-label">ATM Ecosystem</div>
            <ul>
              <li>ATM Research Institutes</li>
              <li>Local Startups</li>
              <li>NRF Singapore</li>
            </ul>
          </div>
        </div>
      </div>
      <div class="collab-right">
        <div class="collab-logos">
          <img src={`${base}/images/partners/icai.png`} alt="ICAI" />
          <img src={`${base}/images/partners/cortaix.jpg`} alt="CortAIx" />
          <img src={`${base}/images/partners/starburst.png`} alt="Starburst" />
          <img src={`${base}/images/partners/ntu.png`} alt="NTU" />
          <img src={`${base}/images/partners/astar.png`} alt="A*STAR" />
          <img src={`${base}/images/partners/canso.png`} alt="CANSO" />
        </div>
      </div>
    </div>
  </section>

  <!-- FOCUS AREA -->
  <section>
    <div class="section-header" data-reveal>
      <h2 class="section-title">Where we <strong>focus</strong></h2>
      <p style="font-size: 15px; color: var(--muted);">AIR Lab focuses on the capabilities that matter most for the region's aviation future.</p>
    </div>
    <div class="focus-grid" data-reveal>
      <div class="focus-item">
        <div class="focus-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
        </div>
        <h3>Trajectory-Based Operations</h3>
        <p>Enabling FF-ICE and TBO across the region through shared data infrastructure and collaborative testing environments.</p>
      </div>
      <div class="focus-item">
        <div class="focus-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        </div>
        <h3>Regional Situational Awareness</h3>
        <p>Providing ANSPs with a shared operational picture of traffic flows, network dependencies, and capacity across Southeast Asia.</p>
      </div>
      <div class="focus-item">
        <div class="focus-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3>Open Collaboration</h3>
        <p>Creating a neutral, open-access space where ANSPs, universities, startups, and established players can innovate together without barriers.</p>
      </div>
    </div>
  </section>

  <!-- PHOTO COLLAGE -->
  <section class="faces-section">
    <div class="section-header" data-reveal>
      <div class="section-label">Faces of AIR Lab</div>
      <h2 class="section-title">The people behind<br><strong>the innovation</strong></h2>
    </div>
    <div class="faces-mosaic" data-reveal>
      <div class="fm-item">
        <img src={`${base}/images/about/faces-5.jpg`} alt="AIR Lab team" loading="lazy" />
      </div>
      <div class="fm-item fm-wide">
        <img src={`${base}/images/about/faces-3.jpg`} alt="AIR Lab team" loading="lazy" />
      </div>
      <div class="fm-item">
        <img src={`${base}/images/about/faces-4.jpg`} alt="AIR Lab team" loading="lazy" />
      </div>
      <div class="fm-item">
        <img src={`${base}/images/about/faces-6.jpg`} alt="AIR Lab team" loading="lazy" />
      </div>
      <div class="fm-item fm-tall">
        <img src={`${base}/images/about/faces-7.jpg`} alt="AIR Lab team" loading="lazy" />
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  /* MISSION */
  .about-mission { padding: 100px max(80px, calc((100vw - 1400px) / 2)); }
  .am-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 80px; align-items: start; }
  .am-intro { font-size: 20px; line-height: 1.7; color: var(--navy); font-weight: 400; font-style: italic; margin-bottom: 20px; border-left: 3px solid var(--teal); padding-left: 20px; }
  .am-body { font-size: 15px; line-height: 1.75; color: var(--muted); }

  /* TEAM STATS */
  .team-stats { padding: 80px max(80px, calc((100vw - 1400px) / 2)); }
  .ts-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px; margin-bottom: 60px; }
  .ts-stat { border-top: 2px solid rgba(0,200,200,0.3); padding-top: 24px; }
  .ts-num { font-size: 52px; font-weight: 700; color: #fff; line-height: 1; margin-bottom: 10px; }
  .ts-num span { font-size: 28px; color: var(--teal); }
  .ts-lbl { font-size: 14px; color: rgba(255,255,255,0.5); line-height: 1.5; }
  .ts-profiles { border-top: 1px solid rgba(255,255,255,0.1); padding-top: 40px; }
  .ts-tags { display: flex; flex-wrap: wrap; gap: 10px; }
  .ts-tags span { background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.15); color: rgba(255,255,255,0.8); border-radius: 100px; padding: 8px 18px; font-size: 14px; font-weight: 500; }

  /* FOUNDING PARTNERS */
  .fp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-top: 48px; }
  .fp-card { background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 40px; }
  .fp-card img { max-height: 48px; max-width: 160px; object-fit: contain; margin-bottom: 24px; }
  .fp-card h3 { font-size: 18px; font-weight: 600; color: var(--navy); margin-bottom: 12px; }
  .fp-card p { font-size: 15px; color: var(--muted); line-height: 1.7; }

  /* COLLABORATION */
  .collab-section { padding: 100px max(80px, calc((100vw - 1400px) / 2)); background: var(--off-white); }
  .collab-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
  .collab-intro { font-size: 15px; color: var(--muted); line-height: 1.75; margin: 20px 0 32px; }
  .collab-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .collab-card { background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 28px; }
  .collab-card-label { font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--teal); margin-bottom: 16px; }
  .collab-card ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .collab-card li { font-size: 14px; color: var(--navy); font-weight: 500; padding-left: 16px; position: relative; }
  .collab-card li::before { content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 6px; height: 6px; background: var(--teal); border-radius: 50%; }
  .collab-right { display: flex; align-items: center; justify-content: center; }
  .collab-logos { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: center; justify-items: center; }
  .collab-logos img { max-height: 70px; max-width: 180px; object-fit: contain; }

  /* FOCUS */
  .focus-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin-top: 48px; }
  .focus-item { padding: 32px; background: var(--off-white); border: 1px solid var(--border); border-radius: 16px; }
  .focus-icon { width: 48px; height: 48px; background: rgba(6,113,129,0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px; }
  .focus-icon svg { width: 24px; height: 24px; stroke: var(--teal); }
  .focus-item h3 { font-size: 16px; font-weight: 700; color: var(--navy); margin-bottom: 10px; }
  .focus-item p { font-size: 14px; color: var(--muted); line-height: 1.65; }

  /* FACES COLLAGE */
  .faces-section { padding: 100px max(80px, calc((100vw - 1400px) / 2)); background: var(--off-white); }
  .faces-mosaic {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: 300px 300px;
    gap: 12px;
    margin-top: 48px;
  }
  .fm-item { overflow: hidden; border-radius: 12px; }
  .fm-item img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s ease; }
  .fm-item:hover img { transform: scale(1.04); }
  .fm-item:nth-child(1) { grid-column: 1; grid-row: 1; }
  .fm-item:nth-child(2) { grid-column: 2; grid-row: 1; }
  .fm-item:nth-child(3) { grid-column: 3; grid-row: 1; }
  .fm-item:nth-child(4) { grid-column: 1 / 3; grid-row: 2; }
  .fm-item:nth-child(5) { grid-column: 3; grid-row: 2; }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .am-grid { grid-template-columns: 1fr; gap: 40px; }
    .ts-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
    .fp-grid { grid-template-columns: 1fr; }
    .collab-inner { grid-template-columns: 1fr; }
    .collab-cards { grid-template-columns: 1fr 1fr; }
    .focus-grid { grid-template-columns: 1fr 1fr; }
    .faces-mosaic { grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(3, 200px); }
    .fm-item:nth-child(1) { grid-column: 1; grid-row: 1; }
    .fm-item:nth-child(2) { grid-column: 2; grid-row: 1; }
    .fm-item:nth-child(3) { grid-column: 1; grid-row: 2; }
    .fm-item:nth-child(4) { grid-column: 2; grid-row: 2; }
    .fm-item:nth-child(5) { grid-column: 1 / 3; grid-row: 3; }
  }
  @media (max-width: 600px) {
    .ts-grid { grid-template-columns: 1fr 1fr; }
    .focus-grid { grid-template-columns: 1fr; }
    .faces-mosaic { grid-template-columns: 1fr; grid-template-rows: auto; }
    .fm-item, .fm-item:nth-child(n) { grid-column: 1; grid-row: auto; height: 220px; }
  }
</style>
